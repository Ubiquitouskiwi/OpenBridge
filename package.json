{
  "name": "openbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, privacy-first benefits eligibility navigator. Screen once for SNAP, Medicaid, WIC and more, entirely on-device.",
  "license": "AGPL-3.0-only",
  "author": "StarlingTek, LLC <openbridge@starlingtek.com> (https://starlingtek.com)",
  "keywords": [
    "benefits",
    "eligibility",
    "snap",
    "medicaid",
    "wic",
    "civic-tech",
    "privacy",
    "pwa"
  ],
  "type": "module",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run e2e -w @openbridge/web-app",
    "release:package": "tsx scripts/release/package-release.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run validate:adapters && npm run test:fixtures && npm run check:reason-keys && npm run check:readability && npm run check:wiki",
    "validate:adapters": "tsx scripts/validate-state-adapter.ts",
    "test:fixtures": "tsx scripts/run-fixtures.ts",
    "check:reason-keys": "tsx scripts/check-reason-keys.ts",
    "seed:fpl": "tsx scripts/seed-fpl-data.ts",
    "check:readability": "tsx scripts/check-readability.ts",
    "check:wiki": "tsx scripts/check-wiki.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
